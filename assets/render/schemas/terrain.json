{
	"model_name": "terrain",

	"permutations": {
		"flags": {},
		"enums": {
			"blend_mode": {
				"opaque": "BLEND_MODE_OPAQUE",
				"masked": "BLEND_MODE_MASKED",
				"translucent": "BLEND_MODE_TRANSLUCENT"
			}
		}
	},

	"material_info": {
		"structure": "GPUMaterial",
		"params": {
			"blend_mode":            { "type": "definition", "definition": "blend_mode" },

			"base_color_factor":     { "type": "float", "member": "params0", "offset": 0 },
			"emissive_factor":       { "type": "float", "member": "params0", "offset": 1 },

			"roughness_factor":      { "type": "float", "member": "params1", "offset": 0 },
			"metallic_factor":       { "type": "float", "member": "params1", "offset": 1 },
			"occlusion_factor":      { "type": "float", "member": "params1", "offset": 2 },

			"layer_tiling":          { "type": "vec4", "member": "params2", "offset": 0 },
			"layer_height_blend":    { "type": "vec4", "member": "params3", "offset": 0 },

			"blend_contrast":        { "type": "float", "member": "params4", "offset": 0 },
			"macro_scale":           { "type": "float", "member": "params4", "offset": 1 },
			"macro_strength":        { "type": "float", "member": "params4", "offset": 2 },
			"triplanar_sharpness":   { "type": "float", "member": "params4", "offset": 3 },

			"layer_tint_0":          { "type": "vec4", "member": "params5", "offset": 0 },
			"layer_tint_1":          { "type": "vec4", "member": "params6", "offset": 0 },
			"layer_tint_2":          { "type": "vec4", "member": "params7", "offset": 0 },
			"layer_tint_3":          { "type": "vec4", "member": "params8", "offset": 0 },
			"layer_roughness":       { "type": "vec4", "member": "params9", "offset": 0 },
			"layer_normal_strength": { "type": "vec4", "member": "params10", "offset": 0 },
			"layer_triplanar":       { "type": "vec4", "member": "params11", "offset": 0 },

			"puddle_tint":           { "type": "vec4", "member": "params12", "offset": 0 },
			"puddle_amount":         { "type": "float", "member": "params13", "offset": 0 },
			"puddle_roughness":      { "type": "float", "member": "params13", "offset": 1 },
			"wet_darkening":         { "type": "float", "member": "params13", "offset": 2 },
			"puddle_density":        { "type": "float", "member": "params13", "offset": 3 },

			"layer0_base_color":    { "type": "texture", "member": "textures0", "offset": 0 },
			"layer0_normal":         { "type": "texture", "member": "textures0", "offset": 1 },
			"layer0_orm":            { "type": "texture", "member": "textures0", "offset": 2 },
			"layer1_base_color":     { "type": "texture", "member": "textures1", "offset": 0 },
			"layer1_normal":         { "type": "texture", "member": "textures1", "offset": 1 },
			"layer1_orm":            { "type": "texture", "member": "textures1", "offset": 2 },
			"splat":                 { "type": "texture", "member": "textures1", "offset": 3 },
			"layer2_base_color":     { "type": "texture", "member": "textures2", "offset": 0 },
			"layer2_normal":         { "type": "texture", "member": "textures2", "offset": 1 },
			"layer2_orm":            { "type": "texture", "member": "textures2", "offset": 2 },
			"puddles":               { "type": "texture", "member": "textures2", "offset": 3 },
			"layer3_base_color":    { "type": "texture", "member": "textures3", "offset": 0 },
			"layer3_normal":         { "type": "texture", "member": "textures3", "offset": 1 },
			"layer3_orm":            { "type": "texture", "member": "textures3", "offset": 2 }
		}
	},

	"pipelines": [
		{
			"__type__": "PipelineInfo_Graphics",
			"pass": "GeometryBase",
			"requirements": "blend_mode != translucent",
			"stages": {
				"vertex": {
					"shader": "geometry.vert",
					"resources": ["camera", "mesh_table", "primitive_table", "draw_list"]
				},
				"fragment": {
					"shader": "terrain.frag",
					"resources": ["camera", "light", "shadow", "reflection", "pbr_material_table", "textures", "draw_list"]
				}
			},
			"depth_write": true,
			"depth_test": true,

			"color_attachments": [
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false }
			],

			"cull_mode": "back",
			"front_face": "CW",
			"compare_op": "less_or_equal",
			"push_constants": [
				{
					"type": "ModelPushConstants",
					"name": "model",
					"stages": ["vertex", "fragment"]
				}
			],
			"topology": "triangle_list",
			"vertex_layouts": [
				{
					"vertex_type": "Vertex",
					"attributes": []
				}
			]
		},
		{
			"__type__": "PipelineInfo_Graphics",
			"pass": "shadowmap",
			"requirements": "blend_mode != translucent",
			"stages": {
				"vertex": {
					"shader": "shadow.vert",
					"resources": ["camera", "light", "primitive_table", "mesh_table", "draw_list"]
				},
				"fragment": {
					"shader": "shadow.frag",
					"resources": []
				}
			},
			"depth_write": true,
			"depth_test": true,
			"translucent": false,
			"cull_mode": "none",
			"front_face": "CCW",
			"compare_op": "less",
			"color_attachments": [
				{
					"write_mask": ["R", "G", "B", "A"],
					"translucent": false
				}
			],
			"push_constants": [
				{
					"type": "ModelPushConstants",
					"name": "model",
					"stages": ["vertex", "fragment"]
				}
			],
			"set": "SET_SHADOW",
			"depth_bias": {
				"enable": true,
				"constant_factor": 0.1,
				"slope_factor": 1.0,
				"clamp": 0
			},
			"topology": "triangle_list",
			"vertex_layouts": [
				{
					"vertex_type": "Vertex",
					"attributes": []
				}
			]
		}
	]
}
