{
	"model_name": "character",

	"supports_masked": true,

	"permutations": {
		"flags": {
			"USE_BASE_COLOR": "base_color",
			"USE_NORMAL_MAP": "normal",
			"USE_ORM": "orm",
			"USE_EMISSIVE": "emissive",
			"USE_TINT_MASK": "tint_mask",
			"USE_HAIR_MASK": "hair_mask",
			"USE_HAIR_NOISE": "hair_noise"
		},
		"enums": {
			"blend_mode": {
				"opaque": "BLEND_MODE_OPAQUE",
				"masked": "BLEND_MODE_MASKED",
				"translucent": "BLEND_MODE_TRANSLUCENT"
			},
			"shading_model": {
				"default_lit": "SHADING_MODEL_DEFAULT_LIT",
				"skin": "SHADING_MODEL_SKIN",
				"hair": "SHADING_MODEL_HAIR"
			}
		},
		"variants": {
			"INSTANCE_DISSOLVE": {
				"values": [0, 1],
				"default_index": 0
			}
		}
	},

	"material_info": {
		"structure": "GPUMaterial",
		"params": {
			"blend_mode":        { "type": "definition", "definition": "blend_mode" },
			"shading_model":     { "type": "definition", "definition": "shading_model" },

			"base_color_factor": { "type": "float", "member": "params0", "offset": 0 },
			"emissive_factor":   { "type": "float", "member": "params0", "offset": 1 },
			"opacity_clip":      { "type": "float", "member": "params0", "offset": 2 },
			"normal_strength":   { "type": "float", "member": "params0", "offset": 3 },

			"roughness_factor":  { "type": "float", "member": "params1", "offset": 0 },
			"metallic_factor":   { "type": "float", "member": "params1", "offset": 1 },
			"occlusion_factor":  { "type": "float", "member": "params1", "offset": 2 },
			"specular":          { "type": "float", "member": "params1", "offset": 3 },

			"tint_01":           { "type": "vec4", "member": "params2", "offset": 0 },
			"tint_02":           { "type": "vec4", "member": "params3", "offset": 0 },
			"tint_03":           { "type": "vec4", "member": "params4", "offset": 0 },
			"tint_select_a":     { "type": "vec4", "member": "params5", "offset": 0 },
			"tint_select_b":     { "type": "vec4", "member": "params6", "offset": 0 },
			"emissive_color":    { "type": "vec4", "member": "params7", "offset": 0 },
			"subsurface":        { "type": "vec4", "member": "params8", "offset": 0 },

			"hair_brightness":   { "type": "float", "member": "params9", "offset": 0 },
			"hair_saturate":     { "type": "float", "member": "params9", "offset": 1 },
			"hair_noise_tiling": { "type": "float", "member": "params9", "offset": 2 },
			"hair_edge_mask_min":{ "type": "float", "member": "params9", "offset": 3 },
			"hair_edge_mask_contrast": { "type": "float", "member": "params10", "offset": 0 },
			"hair_root_tip_blend":     { "type": "float", "member": "params10", "offset": 1 },
			"hair_mip_bias":     { "type": "float", "member": "params10", "offset": 2 },
			"hair_root_color":   { "type": "vec4", "member": "params11", "offset": 0 },
			"hair_tip_color":    { "type": "vec4", "member": "params12", "offset": 0 },
			"hair_tangent_a":    { "type": "vec4", "member": "params13", "offset": 0 },
			"hair_tangent_b":    { "type": "vec4", "member": "params14", "offset": 0 },
			"hair_tangent":      { "type": "vec4", "member": "params15", "offset": 0 },

			"base_color":        { "type": "texture", "member": "textures0", "offset": 0 },
			"normal":            { "type": "texture", "member": "textures0", "offset": 1 },
			"orm":               { "type": "texture", "member": "textures0", "offset": 2 },
			"emissive":          { "type": "texture", "member": "textures0", "offset": 3 },
			"tint_mask":         { "type": "texture", "member": "textures1", "offset": 0 },
			"hair_mask":         { "type": "texture", "member": "textures1", "offset": 1 },
			"hair_noise":        { "type": "texture", "member": "textures1", "offset": 2 }
		}
	},

	"pipelines": [
		{
			"__type__": "PipelineInfo_Graphics",
			"pass": "GeometryBase",
			"requirements": "blend_mode != translucent",
			"stages": {
				"vertex": {
					"shader": "geometry.vert",
					"resources": ["camera", "mesh_table", "primitive_table", "draw_list"]
				},
				"fragment": {
					"shader": "character.frag",
					"resources": ["camera", "light", "shadow", "reflection", "pbr_material_table", "textures", "draw_list"]
				}
			},
			"depth_write": true,
			"depth_test": true,

			"color_attachments": [
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false },
				{ "write_mask": ["R", "G", "B", "A"], "translucent": false }
			],

			"cull_mode": "none",
			"front_face": "CW",
			"compare_op": "less_or_equal",
			"push_constants": [
				{
					"type": "ModelPushConstants",
					"name": "model",
					"stages": ["vertex", "fragment"]
				}
			],
			"topology": "triangle_list",
			"vertex_layouts": [
				{
					"vertex_type": "Vertex",
					"attributes": []
				}
			]
		},
		{
			"__type__": "PipelineInfo_Graphics",
			"pass": "shadowmap",
			"requirements": "blend_mode != translucent",
			"stages": {
				"vertex": {
					"shader": "character_shadow.vert",
					"resources": ["light", "primitive_table", "mesh_table", "draw_list"]
				},
				"fragment": {
					"shader": "character_shadow.frag",
					"resources": ["light", "pbr_material_table", "textures", "draw_list"]
				}
			},
			"depth_write": true,
			"depth_test": true,
			"cull_mode": "none",
			"front_face": "CCW",
			"compare_op": "less",
			"color_attachments": [
				{
					"write_mask": ["R", "G", "B", "A"],
					"translucent": false
				}
			],
			"push_constants": [
				{
					"type": "ModelPushConstants",
					"name": "model",
					"stages": ["vertex", "fragment"]
				}
			],
			"depth_bias": {
				"enable": true,
				"constant_factor": 0.1,
				"slope_factor": 1.0,
				"clamp": 0
			},
			"topology": "triangle_list",
			"vertex_layouts": [
				{
					"vertex_type": "Vertex",
					"attributes": []
				}
			]
		}
	]
}
