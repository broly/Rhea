			},
			"history": {
				"type": "sampler",
				"sampler": "default",
				"variable": "u_fog_history",
				"binding": "BINDING_SAMPLER_FOG_HISTORY"
			}
		},
		"set": "SET_FOG_BUFFERS"
	}
}
