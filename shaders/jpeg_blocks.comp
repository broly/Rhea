#version 450

// Pass "<chain>Blocks" of a masked shakalizer chain (JpegRenderer): the MCUs under its channel of u_jpeg_mask ->
// u_jpeg_blocks, the indirect dispatch of the codec. MCUs are in pixels of the work texture (the source shrunk
// by the downscale factor), the mask in pixels of the source. Two dispatches with a barrier between them:
//   pc.codec.w == 0   one thread: the dispatch counts reset (0 MCUs)
//   pc.codec.w == 1   one thread per MCU of the grid: appended when a mask texel under it is set
// The codec shifts its grid by up to 7 px per generation (MCU x covers [x * size - shift, (x + 1) * size - shift)):
// an MCU is tested over [x * size - 8, (x + 1) * size) work pixels, so every masked pixel is coded whatever the
// shift.

layout(local_size_x = 64) in;

#include "resources/jpeg.glsl"

ivec2 mcu_size(int mode)
{
    switch (mode)
    {
        case JPEG_CHROMA_422: return ivec2(16, 8);
        case JPEG_CHROMA_420: return ivec2(16, 16);
        case JPEG_CHROMA_411: return ivec2(32, 8);
        default: return ivec2(8, 8);
    }
}

void main()
{
    if (pc.codec.w == 0)
    {
        if (gl_GlobalInvocationID.x == 0u)
            u_jpeg_blocks.dispatch = uvec4(0u, 1u, 1u, 0u);
        return;
    }

    const ivec2 mcu = mcu_size(pc.mode.z);
    // the grid of the largest shift
    const ivec2 grid = (pc.extent.xy + 7 + mcu - 1) / mcu;
    const int index = int(gl_GlobalInvocationID.x);
    if (index >= grid.x * grid.y)
        return;
    const ivec2 m = ivec2(index % grid.x, index / grid.x);

    // source pixels [(m * mcu - 8) * factor, (m + 1) * mcu * factor): mcu * factor is a multiple of 8
    const ivec2 factor = jpeg_factor();
    const int channel = jpeg_mask_channel();
    const ivec2 mask_size = imageSize(u_jpeg_mask);
    const ivec2 first = max(m * mcu * factor / JPEG_MASK_BLOCK - factor, ivec2(0));
    const ivec2 last = min(((m + 1) * mcu * factor - 1) / JPEG_MASK_BLOCK, mask_size - 1);
    float strength = 0.0;
    for (int y = first.y; y <= last.y; ++y)
        for (int x = first.x; x <= last.x; ++x)
            strength = max(strength, imageLoad(u_jpeg_mask, ivec2(x, y))[channel]);
    if (strength <= 0.0)
        return;

    const uint slot = atomicAdd(u_jpeg_blocks.dispatch.x, 1u);
    if (slot < uint(u_jpeg_blocks.mcus.length()))
        u_jpeg_blocks.mcus[slot] = uvec2(uint(m.x) | (uint(m.y) << 16), floatBitsToUint(strength));
}
