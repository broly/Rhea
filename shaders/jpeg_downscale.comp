#version 450

// Shakalizer, first pass of a chain (JpegRenderer): the source shrunk by the downscale factor into the top left
// corner of u_jpeg_work, as display encoded 8 bit RGB (what a JPEG encoder gets from a file). The factor may
// differ per axis (jpeg_factor: wider cells smear the rows).
//   nearest: the texel at the center of each factor.x x factor.y cell (hard "pixels")
//   box:     the average of the cell (soap)
// Before the codec, so the JPEG crushes them too (a spot reads on any surface): brightness gain
// (1 + pc.post.y) and color noise of amplitude pc.post.w, new every frame (seed pc.codec.y). Masked chains scale
// both by the strength of their mask channel under the texel (the spot fades out smoothly).

layout(local_size_x = 8, local_size_y = 8) in;

#include "resources/jpeg.glsl"

// 0..1 per channel, stable for a texel and seed
vec3 noise3(ivec2 p, uint seed)
{
    uvec3 h = uvec3(uint(p.x) * 0x8da6b343u, uint(p.y) * 0xd8163841u, seed * 0xcb1ab31fu);
    h = h.x ^ h.y ^ h.z ^ uvec3(0u, 0x9e3779b9u, 0x7f4a7c15u);
    h ^= h >> 16;
    h *= 0x7feb352du;
    h ^= h >> 15;
    h *= 0x846ca68bu;
    h ^= h >> 16;
    return vec3(h & 0xffffffu) / 16777216.0;
}

void main()
{
    const ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(texel, pc.extent.xy)))
        return;

    const ivec2 factor = jpeg_factor();
    const ivec2 source_max = pc.extent.zw - 1;
    const ivec2 origin = texel * factor;

    vec3 color;
    if (pc.mode.y == JPEG_FILTER_NEAREST || factor == ivec2(1))
    {
        color = texelFetch(u_jpeg_source, min(origin + factor / 2, source_max), 0).rgb;
    }
    else
    {
        // edge cells are averaged over their texels inside the source
        const ivec2 cell_end = min(origin + factor, pc.extent.zw);
        color = vec3(0.0);
        for (int y = origin.y; y < cell_end.y; ++y)
            for (int x = origin.x; x < cell_end.x; ++x)
                color += texelFetch(u_jpeg_source, ivec2(x, y), 0).rgb;
        const ivec2 cell = cell_end - origin;
        color /= float(cell.x * cell.y);
    }

    if ((pc.mode.w & JPEG_FLAG_SOURCE_LINEAR) != 0)
        color = jpeg_linear_to_srgb(color);

    const float brightness = pc.post.y;
    const float noise = pc.post.w;
    if (brightness != 0.0 || noise > 0.0)
    {
        float strength = 1.0;
        if ((pc.mode.w & JPEG_FLAG_BLOCK_LIST) != 0)
        {
            const ivec2 source = min(origin + factor / 2, source_max);
            const ivec2 block = min(source / JPEG_MASK_BLOCK, imageSize(u_jpeg_mask) - 1);
            strength = imageLoad(u_jpeg_mask, block)[jpeg_mask_channel()];
        }
        color *= 1.0 + brightness * strength;
        color += (noise3(texel, uint(pc.codec.y)) - 0.5) * 2.0 * noise * strength;
    }

    imageStore(u_jpeg_work, texel, vec4(clamp(color, 0.0, 1.0), 1.0));
}
