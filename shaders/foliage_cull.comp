#version 450

// Grows the ground foliage of the frame (FoliageRenderer, src/game/foliage_renderer.*):
//   mode 0  one invocation per bucket (type x variant x LOD): its indirect draw with no instances
//   mode 1  one invocation per candidate spot of one type: a world anchored grid with a random offset in every
//           cell (spaced for the type's density) around the camera. Keeps the spot by the foliage map, the
//           patches and its own fade distance, culls it by the frustum and the hierarchical depth of the early
//           base pass, picks a variant, appends it to the bucket of the variant at its LOD.

layout(local_size_x = 8, local_size_y = 8) in;

#define FOLIAGE_INSTANCES_WRITE
#include "resources/camera.glsl"
#include "resources/foliage.glsl"
#include "resources/foliage_instances.glsl"
#include "resources/occlusion.glsl"

layout(push_constant) uniform FoliageCullPushConstants
{
    uint mode;
    uint type;
    int first_cell_x;       // grid cell of invocation (0, 0)
    int first_cell_z;
    uint cells;             // per side
    uint bucket_count;      // mode 0
} pc;

float terrain_sample(ivec2 s)
{
    const int last = int(u_foliage.globals.terrain.w) - 1;
    s = clamp(s, ivec2(0), ivec2(last));
    return u_foliage_heights.heights[s.y * (last + 1) + s.x];
}

// Height at a position in samples, split like the terrain mesh and the collision: (x, z) - (x + 1, z + 1)
float terrain_height(vec2 p)
{
    const int last_quad = int(u_foliage.globals.terrain.w) - 2;
    const ivec2 i = clamp(ivec2(floor(p)), ivec2(0), ivec2(last_quad));
    const vec2 t = clamp(p - vec2(i), 0.0, 1.0);
    const float a = terrain_sample(i);
    const float b = terrain_sample(i + ivec2(1, 0));
    const float c = terrain_sample(i + ivec2(0, 1));
    const float d = terrain_sample(i + ivec2(1, 1));
    return t.x >= t.y ? a + (b - a) * t.x + (d - b) * t.y
                      : a + (c - a) * t.y + (d - c) * t.x;
}

vec3 terrain_normal(vec2 p)
{
    const ivec2 i = ivec2(round(p));
    const float spacing = u_foliage.globals.terrain.z;
    const float left = terrain_sample(i - ivec2(1, 0)), right = terrain_sample(i + ivec2(1, 0));
    const float back = terrain_sample(i - ivec2(0, 1)), front = terrain_sample(i + ivec2(0, 1));
    return normalize(vec3(left - right, 2.0 * spacing, back - front));
}

bool in_frustum(vec3 center, float radius)
{
    for (int i = 0; i < 6; ++i)
    {
        const vec4 plane = u_foliage.globals.frustum[i];
        if (dot(plane.xyz, center) + plane.w < -radius)
            return false;
    }
    return true;
}

// hierarchical depth of the early base pass (OcclusionCulling): offset and size of a level
void hzb_level(uint level, out uint offset, out uvec2 size)
{
    offset = 0u;
    size = u_foliage.globals.hzb.xy;
    for (uint i = 0u; i < level; ++i)
    {
        offset += size.x * size.y;
        size = max(size / 2u, uvec2(1u));
    }
}

float hzb_fetch(uint offset, uvec2 size, vec2 uv)
{
    const uvec2 texel = min(uvec2(uv * vec2(size)), size - 1u);
    return u_hzb.depth[offset + texel.y * size.x + texel.x];
}

// Behind the early draws everywhere on the screen rectangle of the box (see occlusion_cull.comp)
bool occluded(vec3 box_min, vec3 box_max)
{
    if (u_foliage.globals.hzb.w == 0u)
        return false;
    const mat4 view_proj = camera_ubo.proj * camera_ubo.view;
    vec2 uv_min = vec2(1.0);
    vec2 uv_max = vec2(0.0);
    float nearest = 1.0;
    for (int corner = 0; corner < 8; ++corner)
    {
        const vec3 p = vec3((corner & 1) != 0 ? box_max.x : box_min.x,
                            (corner & 2) != 0 ? box_max.y : box_min.y,
                            (corner & 4) != 0 ? box_max.z : box_min.z);
        const vec4 clip = view_proj * vec4(p, 1.0);
        if (clip.w <= camera_ubo.near)
            return false;
        const vec3 ndc = clip.xyz / clip.w;
        const vec2 uv = ndc.xy * 0.5 + 0.5;
        uv_min = min(uv_min, uv);
        uv_max = max(uv_max, uv);
        nearest = min(nearest, ndc.z);
    }
    uv_min = clamp(uv_min, 0.0, 1.0);
    uv_max = clamp(uv_max, 0.0, 1.0);
    if (uv_max.x <= uv_min.x || uv_max.y <= uv_min.y)
        return true;

    const vec2 extent = (uv_max - uv_min) * vec2(u_foliage.globals.hzb.xy);
    const uint level = min(uint(ceil(log2(max(max(extent.x, extent.y), 1.0)))), u_foliage.globals.hzb.z - 1u);
    uint offset;
    uvec2 size;
    hzb_level(level, offset, size);
    const float farthest = max(
        max(hzb_fetch(offset, size, uv_min), hzb_fetch(offset, size, vec2(uv_max.x, uv_min.y))),
        max(hzb_fetch(offset, size, vec2(uv_min.x, uv_max.y)), hzb_fetch(offset, size, uv_max)));
    return nearest > farthest;
}

void main()
{
    if (pc.mode == 0u)
    {
        const uint bucket = gl_GlobalInvocationID.x;
        if (bucket >= pc.bucket_count || gl_GlobalInvocationID.y != 0u)
            return;
        const uvec4 draw = u_foliage_buckets.buckets[bucket].draw;
        u_foliage_draws.draws[bucket] = FoliageDraw(draw.x, 0u, draw.y, 0, draw.z);
        return;
    }

    if (gl_GlobalInvocationID.x >= pc.cells || gl_GlobalInvocationID.y >= pc.cells)
        return;
    const FoliageType type = u_foliage.types[pc.type];
    const FoliageGlobals globals = u_foliage.globals;

    const ivec2 cell = ivec2(pc.first_cell_x, pc.first_cell_z) + ivec2(gl_GlobalInvocationID.xy);
    uint state = foliage_hash(uint(cell.x) * 0x8da6b343u ^ foliage_hash(uint(cell.y) * 0xd8163841u ^ floatBitsToUint(type.mask.w)));
    const float spacing = type.placement.w;
    const vec2 xz = (vec2(cell) + vec2(foliage_random(state), foliage_random(state))) * spacing;

    // every plant goes at its own distance between fade start and end, shrinking over the last part of the way
    const float own_end = mix(type.fade.x, type.fade.y, foliage_random(state));
    const float horizontal = distance(xz, globals.camera.xz);
    if (horizontal > own_end)
        return;

    const vec2 local = (xz - globals.terrain.xy) / globals.terrain.z;
    const float last = globals.terrain.w - 1.0;
    if (any(lessThan(local, vec2(0.0))) || any(greaterThan(local, vec2(last))))
        return;
    const vec3 root = vec3(xz.x, globals.terrain_info.x + terrain_height(local), xz.y);
    const float distance_to_camera = distance(root, globals.camera.xyz);
    if (distance_to_camera > own_end)
        return;
    const float band = max(0.2 * (type.fade.y - type.fade.x), 1.5);
    const float scale = 1.0 - smoothstep(own_end - band, own_end, distance_to_camera);
    if (scale < 0.05)
        return;

    // density: the channel of the foliage map, the patches
    float density = textureLod(u_foliage_mask, local / last, 0.0)[uint(type.placement.y)];
    density = clamp((density - type.mask.x) / max(1.0 - type.mask.x, 1e-3), 0.0, 1.0);
    if (type.mask.y > 0.0)
    {
        const float n = foliage_noise(xz / type.mask.y + type.mask.w * 13.7);
        // noise is ~uniform around 0.5: coverage c keeps the part above 1 - c
        const float edge = 1.0 - type.mask.z;
        density *= smoothstep(edge - 0.06, edge + 0.06, n);
    }
    if (foliage_random(state) >= density)
        return;

    // bounds: the largest variant at the largest scale, bent over or pushed aside
    const float size = type.size.y * scale;
    const float height = type.bounds.y * size;
    const float reach = type.bounds.x * size + 0.4 * height;
    const vec3 box_min = root - vec3(reach, 0.1, reach);
    const vec3 box_max = root + vec3(reach, height, reach);
    const vec3 center = 0.5 * (box_min + box_max);
    if (!in_frustum(center, length(box_max - center)))
        return;
    if (occluded(box_min, box_max))
        return;

    const uint lod = distance_to_camera < type.fade.z ? 0u : distance_to_camera < type.fade.w ? 1u : 2u;
    const uint variant = min(uint(foliage_random(state) * type.placement.x), uint(type.placement.x) - 1u);
    const uint bucket = type.buckets.x + variant * FOLIAGE_LODS + lod;
    const uvec4 draw = u_foliage_buckets.buckets[bucket].draw;
    const uint index = atomicAdd(u_foliage_draws.draws[bucket].instance_count, 1u);
    if (index >= draw.w)
    {
        // full: undo (the count ends at the capacity)
        atomicAdd(u_foliage_draws.draws[bucket].instance_count, uint(-1));
        return;
    }

    const vec3 normal = terrain_normal(local);
    const float plant_scale = mix(type.size.x, type.size.y, foliage_random(state)) * scale;
    FoliageInstance instance;
    instance.position_scale = vec4(root - vec3(0.0, type.size.z * plant_scale, 0.0), plant_scale);
    instance.info = uvec4(foliage_hash(state), packSnorm2x16(normal.xz), bucket, 0u);
    u_foliage_instances.instances[draw.z + index] = instance;
}
