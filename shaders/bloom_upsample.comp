#version 450

// One level of the bloom chain going up (PostProcessRenderer, passes "BloomUp<N>"): the smaller level
// u_pp_source upsampled with a 3 x 3 tent, blended with this level of the down chain (u_pp_source_add):
//     up[n] = mix(down[n], tent(up[n + 1]), scatter)
// The result stays a weighted average of the levels (no energy is added): level n gets
// (1 - scatter) * scatter^n of the final bloom, so a higher scatter spreads the glow wider.

layout(local_size_x = 8, local_size_y = 8) in;

#include "resources/post_process.glsl"

layout(push_constant) uniform BloomPushConstants
{
    vec4 params;    // x: first level flag (unused here), y: scatter
} pc;

vec3 tap(vec2 uv)
{
    return textureLod(u_pp_source, uv, 0.0).rgb;
}

void main()
{
    const ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(u_pp_target);
    if (any(greaterThanEqual(texel, size)))
        return;

    const vec2 uv = (vec2(texel) + 0.5) / vec2(size);
    // one texel of the smaller level
    const vec2 s = 1.0 / vec2(textureSize(u_pp_source, 0));

    // 1 2 1
    // 2 4 2  / 16
    // 1 2 1
    vec3 low = tap(uv) * 4.0;
    low += (tap(uv + vec2(-s.x, 0.0)) + tap(uv + vec2(s.x, 0.0)) + tap(uv + vec2(0.0, -s.y)) + tap(uv + vec2(0.0, s.y))) * 2.0;
    low += tap(uv + vec2(-s.x, -s.y)) + tap(uv + vec2(s.x, -s.y)) + tap(uv + vec2(-s.x, s.y)) + tap(uv + vec2(s.x, s.y));
    low *= 1.0 / 16.0;

    const vec3 current = texelFetch(u_pp_source_add, texel, 0).rgb;
    imageStore(u_pp_target, texel, vec4(mix(current, low, clamp(pc.params.y, 0.0, 1.0)), 1.0));
}
